{
  "name": "duocode",
  "version": "1.0.0",
  "description": "Duolingo-gamified terminal learning CLI powered by Claude Code vibes",
  "type": "module",
  "bin": {
    "duocode": "./bin/duocode.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist/test/*.js || tsx test/runTests.ts"
  },
  "keywords": [
    "cli",
    "gamification",
    "learning",
